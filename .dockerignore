# The image needs only requirements-server.txt, src/, index/careerpilot.db and .llm_cache/
# (see Dockerfile). scripts/deploy_space.py stages exactly those; this file keeps a build
# from the repo root equally small.
.git
.env
.env.*
CLAUDE.md
data/
index/whole_postings.db
**/*.db-wal
**/*.db-shm
frontend/
tests/
docs/
outputs/
scripts/
build/
.pytest_cache/
.pytest_tmp/
.mypy_cache/
**/__pycache__
**/*.pyc
**/*.pyo
