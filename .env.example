# Groq API configuration
GROQ_API_KEY=
GROQ_FAST_MODEL=openai/gpt-oss-20b
GROQ_AGENT_MODEL=openai/gpt-oss-120b

# Per-step models: "fast", "agent", or an explicit Groq model id
PROFILE_MODEL=fast
GAP_MODEL=agent
TAILOR_MODEL=agent
VERIFIER_MODEL=agent
# Used in order when a model is still rate-limited (429) after retries; empty disables fallback
GROQ_FALLBACK_MODELS=openai/gpt-oss-120b,openai/gpt-oss-20b,qwen/qwen3.8-27b

# Hidden reasoning budget for gpt-oss models (none/low/medium/high)
GROQ_REASONING_EFFORT=low

# Browser origins allowed to call the API (comma-separated; the Next.js UI)
# To test from another device on your local network, add your LAN IP here (e.g. http://192.168.1.50:3000)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# 'production' removes POST /ingest (set by the Dockerfile)
APP_ENV=development

# Admin token for POST /ingest (sent as the X-Admin-Token header). Empty disables /ingest.
ADMIN_TOKEN=

# Data paths (defaults work if data/ is in project root)
DATA_RAW_DIR=data
INDEX_PATH=index/careerpilot.db

# Retrieval
BM25_TOP_N=50
RERANK_TOP_K=10
