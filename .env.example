# Groq API configuration
GROQ_API_KEY=
GROQ_FAST_MODEL=openai/gpt-oss-20b
GROQ_AGENT_MODEL=openai/gpt-oss-120b

# Per-step models: "fast", "agent", or an explicit Groq model id
PROFILE_MODEL=fast
GAP_MODEL=agent
TAILOR_MODEL=agent
VERIFIER_MODEL=agent
# Hidden reasoning budget for gpt-oss models (none/low/medium/high)
GROQ_REASONING_EFFORT=low

# Admin token for POST /ingest (sent as the X-Admin-Token header). Empty disables /ingest.
ADMIN_TOKEN=

# Data paths (defaults work if data/ is in project root)
DATA_RAW_DIR=data
INDEX_PATH=index/careerpilot.db

# Retrieval
BM25_TOP_N=50
RERANK_TOP_K=10
